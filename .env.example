# --- LLM Providers (pelo menos um é obrigatório) ---
# OpenCode Zen (primário — múltiplos modelos free) — https://opencode.ai/zen
OPENCODE_API_KEY=tua_chave_opencode_aqui
# DeepSeek (fallback 1 — 5M tokens grátis) — https://platform.deepseek.com
DEEPSEEK_API_KEY=tua_chave_deepseek_aqui
# Groq (fallback 2 — free forever) — https://console.groq.com/keys
GROQ_API_KEY=tua_chave_groq_aqui

# --- Reddit (app tipo "script") ---
# Cria em: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=teu_client_id_do_reddit
REDDIT_CLIENT_SECRET=teu_client_secret_do_reddit
REDDIT_USERNAME=teu_username
REDDIT_PASSWORD=tua_password

# --- Post a editar (opcional na 1ª execução) ---
# Deixa vazio na 1ª vez para o bot CRIAR a thread.
# Depois copia o ID impresso no log e define-o aqui.
REDDIT_POST_ID=

# --- Link do repositório (opcional) ---
# No GitHub Actions é injetado automaticamente.
GITHUB_REPO_URL=https://github.com/teu-user/PortoBotNews
